{
  "$defs": {
    "Availability": {
      "anyOf": [
        {
          "format": "double",
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/Period"
          },
          "type": "array"
        }
      ],
      "description": "A calendar fraction: a scalar covers the whole project, a period list\ncovers named stretches (part-time, vacations)."
    },
    "Executor": {
      "additionalProperties": false,
      "description": "A human or an agent, uniformly. Humans wear `availability` (a calendar\nfraction); agents wear `concurrency` (parallel slots). Nothing marks which\nkind an executor is — the capacity fields they carry are the only difference.",
      "properties": {
        "availability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Availability"
            },
            {
              "type": "null"
            }
          ]
        },
        "concurrency": {
          "description": "Parallel slots; default 1.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ids": {
          "additionalProperties": true,
          "description": "Tracker ids, e.g. `{ jira: 3294783, linear: 82374392 }`.",
          "type": [
            "object",
            "null"
          ]
        },
        "role-weights": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "description": "Within-person capacity split, normalized inside this one executor.",
          "type": [
            "object",
            "null"
          ]
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "description": "One availability stretch. `until` absent means open-ended.",
      "properties": {
        "fraction": {
          "format": "double",
          "type": "number"
        },
        "from": {
          "format": "date",
          "type": "string"
        },
        "until": {
          "format": "date",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "fraction"
      ],
      "type": "object"
    },
    "Status": {
      "description": "The four-value status enum; small enough to round-trip through any tracker.",
      "enum": [
        "todo",
        "in-progress",
        "blocked",
        "done"
      ],
      "type": "string"
    },
    "Task": {
      "additionalProperties": false,
      "description": "A unit of work. `estimate` is optional per task: plans mature by gaining\nfields, and maturity is derived, never declared.",
      "properties": {
        "blocked-reason": {
          "description": "Free text; only meaningful with `status: blocked`.",
          "type": [
            "string",
            "null"
          ]
        },
        "depends-on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "estimate": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ],
          "description": "Written by sync tooling, never hand-typed. Absent means `todo`."
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The plan: the only human-authored file. Nothing derived is ever stored here.",
  "properties": {
    "deadline": {
      "description": "Whole-project deadline — the only date a human writes.",
      "format": "date",
      "type": "string"
    },
    "executors": {
      "additionalProperties": {
        "$ref": "#/$defs/Executor"
      },
      "type": "object"
    },
    "roles": {
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      },
      "description": "Declared role vocabulary; descriptions are optional and feed the authoring agent.",
      "type": "object"
    },
    "tasks": {
      "additionalProperties": {
        "$ref": "#/$defs/Task"
      },
      "type": "object"
    },
    "unit": {
      "description": "Plan-level estimate unit. Only `person-hours` is valid in v1.",
      "type": "string"
    }
  },
  "required": [
    "unit",
    "deadline",
    "roles",
    "tasks",
    "executors"
  ],
  "title": "Plan",
  "type": "object"
}
